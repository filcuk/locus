# Copy to deploy/.env and fill in. Keys from DESIGN §7.

# External Postgres; omit for embedded PGlite under /data
DATABASE_URL=

# JWT / token signing — required
SECRET_KEY=change-me

# Session TTLs (refresh must tolerate long offline periods)
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Media and (when PGlite) DB data live under the parent of MEDIA_ROOT
MEDIA_ROOT=/data/media

# Tile style served to clients; unset ⇒ OpenFreeMap Liberty
# https://tiles.openfreemap.org/styles/liberty
MAP_STYLE_URL=

# Web origins for this instance (comma-separated, or *)
CORS_ORIGINS=*

# Link generation base
PUBLIC_BASE_URL=http://localhost:8000

# Listen port (Compose maps 8000:8000)
PORT=8000

# Optional SMTP for password reset, verification, invites
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional outbound notifications (Apprise-compatible / ntfy / raw webhook)
NOTIFY_WEBHOOK_URL=

# Used only by docker-compose.postgres.yml
POSTGRES_USER=locus
POSTGRES_PASSWORD=locus
POSTGRES_DB=locus
