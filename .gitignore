# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Expo — native projects are generated by prebuild, not committed
.expo/
.expo-shared/
apps/app/android/
apps/app/ios/
*.apk
*.aab

# Environment — .env.example is the only env file that belongs in git
.env
.env.*
!.env.example

# Local instance data: PGlite database and uploaded media
/data/

# Test and coverage output
coverage/
test-results/
playwright-report/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor and OS
.DS_Store
Thumbs.db
*.swp
